rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check admin authorization
    function isAdmin() {
      return isAuthenticated();
    }

    // School Profile Information
    match /school_info/{docId} {
      allow read, write: if true;
    }

    // Admissions Configuration & Content
    match /admissions/{docId} {
      allow read, write: if true;
    }

    // Hero Carousel Slides
    match /hero_slides/{slideId} {
      allow read, write: if true;
    }

    // Academic Wings & Curriculum
    match /academics/{academicId} {
      allow read, write: if true;
    }

    // Notice Board & Official Circulars
    match /notices/{noticeId} {
      allow read, write: if true;
    }

    // Student & Parent Resources
    match /resources/{resourceId} {
      allow read, write: if true;
    }

    // Events & Calendar
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Campus Photo Gallery
    match /gallery/{itemId} {
      allow read, write: if true;
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // Contact & Admission Enquiries
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }

    // Admin Users Directory
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // System Seeding & Maintenance Tracking
    match /initial_seed/{seedId} {
      allow read, write: if true;
    }

    // Catch-all rule for all other documents and subcollections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


